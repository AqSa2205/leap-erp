# ─────────────────────────────────────────────────────────────────────────
#  Leap ERP — local development environment
#
#  Copy this file to `.env` and edit as needed:
#      cp .env.example .env
#
#  `.env` is gitignored. NEVER commit it, and never paste real production
#  secrets into it.
#
#  IMPORTANT: for normal local development you do not need to set ANY of
#  these. Django already falls back to a local SQLite database, a throwaway
#  dev SECRET_KEY, and DEBUG=True. An empty .env is a perfectly good .env.
# ─────────────────────────────────────────────────────────────────────────


# ══ DATABASE ═════════════════════════════════════════════════════════════
#
#  ⚠️  DO NOT SET DATABASE_URL ON YOUR LAPTOP.  ⚠️
#
#  Leave it unset and Django uses local SQLite (db.sqlite3) automatically.
#
#  Pointing a local checkout at the production database is how you delete
#  live company data. A single `manage.py migrate`, `flush`, `loaddata`, or
#  a test run against the wrong database can destroy real client records.
#  This has already cost this project its entire commercial pipeline once.
#
#  The production DATABASE_URL is not shared with developers. If you think
#  you need production data, ask for a sanitized dump instead.
#
# DATABASE_URL=            ← leave commented out. Seriously.


# ══ CORE DJANGO ══════════════════════════════════════════════════════════

# Optional locally — a dev fallback key is used when this is unset.
# Production sets its own; never reuse a production key locally.
# SECRET_KEY=some-random-string-for-local-only

# Defaults to True locally, and is forced False in production.
# DEBUG=True

# Comma-separated. Defaults to localhost,127.0.0.1 — usually fine as-is.
# ALLOWED_HOSTS=localhost,127.0.0.1

# Leave as 'development'. Setting this to 'production' locally turns on
# production security checks and will refuse to start without a SECRET_KEY.
# DJANGO_ENV=development


# ══ FILE STORAGE (Cloudflare R2) ═════════════════════════════════════════
#
#  Leave USE_R2 off locally. Uploads then go to the local media/ folder
#  instead of the shared production bucket — so your test uploads can't
#  land in, or overwrite, real company documents.
#
# USE_R2=False
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT_URL=


# ══ EMAIL ════════════════════════════════════════════════════════════════
#
#  Use the console backend locally: emails print to your terminal instead
#  of being sent. This stops test runs from emailing real staff and clients.
#
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Leap ERP <notifications@leap-arabia.com>

#  Microsoft Graph app registration (client-credentials/application auth) —
#  needed if EMAIL_BACKEND is switched to notifications.graph_email_backend,
#  and separately needed for the "Add Emails" live-inbox flow on Commercial
#  Pipeline entries (projects/graph_mail.py), which reads a mailbox via
#  Graph's Mail.Read application permission regardless of EMAIL_BACKEND.
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
#  Mailbox the "Add Emails" live inbox reads from (Mail.Read, read-only).
# PIPELINE_EMAIL_MAILBOX=


# ══ AI FEATURES (optional) ═══════════════════════════════════════════════
#
#  Only needed if you are working on the quotation-import or dev-tracking
#  features. Without a key those features are simply unavailable locally;
#  everything else works fine. Use your own key, not a shared one.
#
# ANTHROPIC_API_KEY=
# PROCUREMENT_AI_MODEL=claude-sonnet-4-6
# DEVTRACKING_AI_MODEL=claude-sonnet-4-6

# Only needed for the dev-tracking GitHub integration.
# GITHUB_TOKEN=


# ══ RECOVERY (production incident use only) ══════════════════════════════
#
#  Set ONLY while running `manage.py recover_project` against a Render
#  Point-in-Time-Recovery copy, then remove it immediately. A PITR instance
#  bills for as long as it exists. Never set this on a developer machine.
#
# RECOVERY_DATABASE_URL=
